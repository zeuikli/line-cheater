{
  "name": "line-cheater-desktop",
  "productName": "LINE Cheater",
  "version": "0.1.28",
  "private": true,
  "description": "LINE Cheater desktop app with a bounded-memory Rust backup core",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test ../frontend/data-provider.test.js session-cache.test.cjs sidecar-client.test.cjs update-checker.test.cjs renderer-shell.test.cjs",
    "build:native:mac": "cargo build --manifest-path ../../Cargo.toml -p line-cheater --release",
    "package:mac": "npm test && npm run build:native:mac && node scripts/package-macos.cjs",
    "package:dmg": "./scripts/package-dmg.sh",
    "measure:rss": "./scripts/measure-peak-rss.sh --",
    "build:native:win": "cargo build --manifest-path ../../Cargo.toml -p line-cheater --release",
    "package:win": "npm test && npm run build:native:win && node scripts/package-windows.cjs"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "rcedit": "5.0.2"
  }
}
